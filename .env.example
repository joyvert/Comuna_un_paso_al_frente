# Database connection example
PGHOST=localhost
PGPORT=5432
PGDATABASE=comuna_db
PGUSER=postgres
PGPASSWORD=your_password_here
PGSSL=false

# API configuration
API_PORT=4000
VITE_API_URL=http://localhost:4000/api

# JWT (obligatorio para /api/data y panel). En desarrollo hay un valor por defecto inseguro si no defines nada.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Si es true, cualquiera puede usar POST /auth/register (el primer usuario de una BD vacía sigue siendo admin)
# ALLOW_PUBLIC_REGISTER=false

# Seguridad: intentos fallidos (login / recuperación) y rate limiting
# TRUST_PROXY=1  # si la API está detrás de nginx/Ingress
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_LOCKOUT_MS=900000
AUTH_RECOVERY_MAX_FAILURES=5
AUTH_RECOVERY_WINDOW_MS=3600000
AUTH_RECOVERY_LOCKOUT_MS=3600000
AUTH_RATE_LIMIT_MAX=200
AUTH_LOGIN_IP_MAX=40
AUTH_SENSITIVE_GET_MAX=60
AUTH_RECOVERY_IP_MAX=25
AUTH_REGISTER_IP_MAX=15

